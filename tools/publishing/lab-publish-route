#!/usr/bin/bash
# Installed root-owned. This helper never reads code or configuration from coder's files.
set -euo pipefail
export PATH=/usr/bin:/bin
[[ $EUID == 0 ]] || { echo 'Administrative route helper requires root.' >&2; exit 1; }
[[ $# == 1 || $# == 3 ]] || exit 2
exec 9>/run/lab-publish-route.lock
flock 9
config=$(tailscale serve status --json)
host=$(tailscale status --json | jq -er '.Self.DNSName | rtrimstr(".")')
[[ $host =~ ^[a-zA-Z0-9.-]+$ ]] || exit 2
case $1 in
  reports)
    [[ $# == 1 ]] || exit 2
    authority=$host:443; path=/reports/; target=http://127.0.0.1:8379
    ;;
  preview|stop)
    [[ $# == 3 && $2 =~ ^[0-9]{4}$ && $3 =~ ^[0-9]{5}$ ]] || exit 2
    (( 10#$2 >= 8400 && 10#$2 <= 9999 && 10#$3 >= 20000 && 10#$3 <= 29999 )) || exit 2
    authority=$host:$2; path=/; target=http://127.0.0.1:$3
    ;;
  *) exit 2 ;;
esac
# Refuse a public listener or an endpoint that belongs to someone else.
jq -e --arg key "$authority" '.AllowFunnel[$key] != true' <<<"$config" >/dev/null || { echo 'Refusing a Funnel listener.' >&2; exit 1; }
current=$(jq -r --arg key "$authority" --arg path "$path" '.Web[$key].Handlers[$path].Proxy // empty' <<<"$config")
exists=$(jq -r --arg key "$authority" --arg path "$path" '.Web[$key].Handlers[$path] != null' <<<"$config")
[[ $exists == false || $current == "$target" ]] || { echo 'Route collision; existing handler preserved.' >&2; exit 1; }
if [[ $1 == reports ]]; then
  jq -e --arg key "$authority" '(.Web[$key].Handlers // {} | keys) | all(.[]; . == "/reports/" or (startswith("/reports") | not))' <<<"$config" >/dev/null || { echo 'An overlapping reports route exists; preserve and review it.' >&2; exit 1; }
  tailscale serve --bg --https=443 --set-path=/reports/ "$target"
elif [[ $1 == preview ]]; then
  jq -e --arg key "$authority" '(.Web[$key].Handlers // {} | keys) - ["/"] | length == 0' <<<"$config" >/dev/null || exit 1
  tailscale serve --bg --https="$2" "$target"
else
  if [[ $exists == true ]]; then
    jq -e --arg key "$authority" '(.Web[$key].Handlers | keys) == ["/"]' <<<"$config" >/dev/null || exit 1
    tailscale serve --https="$2" off
  fi
fi
