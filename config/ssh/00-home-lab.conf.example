# Review global Include order and Match blocks before installation.
# Example destination: /etc/ssh/sshd_config.d/00-home-lab.conf
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM yes
AllowAgentForwarding no
X11Forwarding no
AllowTcpForwarding local
GatewayPorts no
